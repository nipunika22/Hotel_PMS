# Database Configuration: MongoDB Atlas (Exclusively used for development and production)
DB_MODE=atlas
ALLOW_LOCAL_FALLBACK=false
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/hotel_pms?retryWrites=true&w=majority
JWT_SECRET=<long-random-secret>
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
